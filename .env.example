# Environment variables Startup Tracker reads. All are optional.
# Copy to .env only for your own reference; the app does not load .env files itself.

# Port the server listens on. Default 57322 (57323 with npm run dev). 0 picks a free port.
PORT=57322
# Data folder (database, media, backups, secrets). Default ~/.startup-tracker (~/.startup-tracker-dev with --dev).
STARTUP_TRACKER_HOME=
# Set to 1 to keep the server off the network (no agent registry fetch). Tests set it.
STARTUP_TRACKER_OFFLINE=
# Set to 1 in test runs: the default data folder is refused, so a test never reaches real data.
STARTUP_TRACKER_TEST_RUN=
# Extra host names allowed to reach the server, comma-separated (advanced: other devices on your network).
ALLOWED_HOSTS=
# Set to 1 to stop the server from opening a browser tab on start.
NO_OPEN=
# Name shown as the author of your edits in record history. Empty shows "You".
TRACKER_UI_ACTOR=
# Largest upload in bytes. Default 104857600 (100 MB).
MAX_UPLOAD_BYTES=
# Largest save request in bytes. Default 52428800 (50 MB).
MAX_STATE_BODY_BYTES=
# Override single locations inside the data folder (used by tests).
TRACKER_DB_PATH=
TRACKER_BACKUP_DIR=
TRACKER_MEDIA_DIR=
# Private leak-check patterns file, outside every repository (tools/check-leaks.js).
LEAK_PATTERNS_FILE=

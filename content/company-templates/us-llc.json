  "setupSteps": [
    {
      "id": "choose-state",
      "title": "Choose the formation state",
      "description": "The state sets the formation fee, annual report and taxes. Many founders form where they operate.",
      "authority": "Secretary of State",
      "typicalCost": null,
      "dependsOn": [],
      "checkLocally": false,
      "sourceIds": [
        "sba-register"
      ]
    },
    {
      "id": "name",
      "title": "Choose and check the name",
      "description": "Check the name is free in the formation state; some states let you reserve it.",
      "authority": "Secretary of State",
      "typicalCost": null,
      "dependsOn": [
        "choose-state"
      ],
      "checkLocally": false,
      "sourceIds": [
        "sba-register",
        "de-howto"
      ]
    },
    {
      "id": "registered-agent",
      "title": "Appoint a registered agent",
      "description": "Every state requires one with a physical address in the state.",
      "authority": "Secretary of State",
      "typicalCost": null,
      "dependsOn": [
        "choose-state"
      ],
      "checkLocally": false,
      "sourceIds": [
        "sba-register",
        "de-howto"
      ]
    },
    {
      "id": "file-formation",
      "title": "File the certificate of formation",
      "description": "Also called articles of organization. Fees and forms differ by state.",
      "authority": "Secretary of State",
      "typicalCost": null,
      "dependsOn": [
        "name",
        "registered-agent"
      ],
      "checkLocally": false,
      "sourceIds": [
        "sba-register",
        "de-howto"
      ]
    },
    {
      "id": "operating-agreement",
      "title": "Write an operating agreement",
      "description": "Sets out ownership and how the LLC is run. Not filed with the state in most cases.",
      "authority": "Members",
      "typicalCost": null,
      "dependsOn": [
        "file-formation"
      ],
      "checkLocally": true,
      "sourceIds": []
    },
    {
      "id": "ein",
      "title": "Get an EIN",
      "description": "Apply online with the IRS for free; the number is issued at once if approved.",
      "authority": "IRS",
      "typicalCost": null,
      "dependsOn": [
        "file-formation"
      ],
      "checkLocally": false,
      "sourceIds": [
        "ein"
      ]
    },
    {
      "id": "tax-classification",
      "title": "Decide the federal tax classification",
      "description": "Keep the default (disregarded entity for one member, partnership for two or more) or elect corporate treatment with Form 8832.",
      "authority": "IRS",
      "typicalCost": null,
      "dependsOn": [
        "ein"
      ],
      "checkLocally": false,
      "sourceIds": [
        "irs-llc",
        "form-8832"
      ]
    },
    {
      "id": "state-tax",
      "title": "Register for state taxes",
      "description": "Sales tax, payroll and other state registrations depend on the state and the business.",
      "authority": "State tax agency",
      "typicalCost": null,
      "dependsOn": [
        "file-formation"
      ],
      "checkLocally": true,
      "sourceIds": [
        "sba-register"
      ]
    },
    {
      "id": "bank-account",
      "title": "Open a business bank account",
      "description": "Banks usually ask for the formation documents and the EIN.",
      "authority": "Bank",
      "typicalCost": null,
      "dependsOn": [
        "ein"
      ],
      "checkLocally": true,
      "sourceIds": [
        "de-howto"
      ]
    },
    {
      "id": "boi",
      "title": "Beneficial ownership report: not needed",
      "description": "FinCEN's rules now exempt companies created in the United States from BOI reporting; only some foreign companies registered in the US report.",
      "authority": "FinCEN",
      "typicalCost": null,
      "dependsOn": [
        "file-formation"
      ],
      "checkLocally": false,
      "sourceIds": [
        "boi"
      ]
    }

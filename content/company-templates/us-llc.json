  "obligations": [
    {
      "id": "form-1065",
      "title": "Partnership return (Form 1065)",
      "description": "Due by the 15th day of the 3rd month after the tax year ends (March 15 for a calendar year).",
      "frequency": "annual",
      "due": {
        "rule": "relative-to-fiscal-year-end",
        "months": 3,
        "day": 15
      },
      "conditions": [
        "multi-member"
      ],
      "subdivisions": [],
      "authority": "IRS",
      "checkLocally": false,
      "sourceIds": [
        "i1065"
      ]
    },
    {
      "id": "form-1120",
      "title": "Corporate income tax return (Form 1120)",
      "description": "For an LLC taxed as a C corporation: due by the 15th day of the 4th month after the tax year ends (a June 30 year end has other rules).",
      "frequency": "annual",
      "due": {
        "rule": "relative-to-fiscal-year-end",
        "months": 4,
        "day": 15
      },
      "conditions": [
        "taxed-as-corporation"
      ],
      "subdivisions": [],
      "authority": "IRS",
      "checkLocally": false,
      "sourceIds": [
        "i1120"
      ]
    },
    {
      "id": "estimated-tax",
      "title": "Estimated tax payments",
      "description": "Owners of a disregarded or partnership LLC may owe estimated tax on their own returns; an LLC taxed as a corporation pays if it expects to owe $500 or more. Check the installment dates with the IRS.",
      "frequency": "on-event",
      "due": {
        "rule": "manual"
      },
      "conditions": [],
      "subdivisions": [],
      "authority": "IRS",
      "checkLocally": true,
      "sourceIds": [
        "estimated"
      ]
    },
    {
      "id": "state-annual-report",
      "title": "State annual report or tax",
      "description": "Most formation states require an annual or biennial report, a fee or a tax. Add the date for your state.",
      "frequency": "on-event",
      "due": {
        "rule": "manual"
      },
      "conditions": [],
      "subdivisions": [],
      "authority": "Secretary of State",
      "checkLocally": true,
      "sourceIds": [
        "sba-register"
      ]
    },
    {
      "id": "de-annual-tax",
      "title": "Delaware LLC annual tax",
      "description": "Every LLC formed or registered in Delaware pays $400 a year on or before June 1; there is no annual report.",
      "frequency": "annual",
      "due": {
        "rule": "fixed-date",
        "month": 6,
        "day": 1
      },
      "conditions": [],
      "subdivisions": [
        "US-DE"
      ],
      "authority": "Delaware Division of Corporations",
      "checkLocally": false,
      "sourceIds": [
        "de-llc-tax"
      ]
    },
    {
      "id": "form-941",
      "title": "Employer's quarterly federal tax return (Form 941)",
      "description": "File by the last day of the month after each quarter: April 30, July 31, October 31 and January 31. If all taxes were deposited on time, you have 10 more days.",
      "frequency": "quarterly",
      "due": {
        "rule": "relative-to-period-end",
        "months": 1,
        "day": "last"
      },
      "conditions": [
        "has-employees"
      ],
      "subdivisions": [],
      "authority": "IRS",
      "checkLocally": false,
      "sourceIds": [
        "employment-due"
      ]
    },
    {
      "id": "form-w2",
      "title": "Forms W-2 to employees and the SSA",
      "description": "Report each employee's wages and withholding for the previous year.",
      "frequency": "annual",
      "due": {
        "rule": "fixed-date",
        "month": 1,
        "day": 31
      },
      "conditions": [
        "has-employees"
      ],
      "subdivisions": [],
      "authority": "IRS and Social Security Administration",
      "checkLocally": true,
      "sourceIds": [
        "employment-due"
      ]
    },
    {
      "id": "form-940",
      "title": "Federal unemployment tax return (Form 940)",
      "description": "Report FUTA wages for the previous year by January 31 (10 more days if all FUTA tax was deposited on time).",
      "frequency": "annual",
      "due": {
        "rule": "fixed-date",
        "month": 1,
        "day": 31
      },
      "conditions": [
        "has-employees"
      ],
      "subdivisions": [],
      "authority": "IRS",
      "checkLocally": false,
      "sourceIds": [
        "employment-due"
      ]
    },
    {
      "id": "form-1099-nec",
